{
  "name": "storytime-waitlist-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "pm2:start:prod": "npx pm2 start ecosystem.config.js --only storytime-waitlist-production",
    "pm2:start:dev": "npx pm2 start ecosystem.config.js --only storytime-waitlist-development",
    "pm2:restart:prod": "npx pm2 restart storytime-waitlist-production --update-env || npm run pm2:start:prod",
    "pm2:restart:dev": "npx pm2 restart storytime-waitlist-development --update-env || npm run pm2:start:dev",
    "pm2:stop:prod": "npx pm2 stop storytime-waitlist-production",
    "pm2:stop:dev": "npx pm2 stop storytime-waitlist-development",
    "pm2:save": "npx pm2 save"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.7",
    "@portabletext/react": "^6.2.0",
    "@portabletext/types": "^4.0.0",
    "@sanity/client": "^7.23.2",
    "@sanity/image-url": "^2.1.1",
    "@sentry/nextjs": "^10.71.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.554.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
